options gen2
require fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        // Example of c++ module.
        // Dynamic c++ modules can only be used with dyn build.
        register_dynamic_module("{project_path}/hello_Module.mod", "Module_Hello", 2)
    }
    // Example of das module.
    register_native_path("Hello", "hello_module", "{project_path}/hello_module.das")
}
